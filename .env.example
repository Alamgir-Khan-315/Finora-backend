# Local use: copy to .env. On Vercel add these in Settings > Environment Variables instead.
PORT=5000
NODE_ENV=production
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@cluster.mongodb.net/
MONGODB_DB=finora_finance
CLIENT_ORIGIN=http://localhost:5173,https://YOUR-FRONTEND.vercel.app
SYNC_API_KEY=replace-with-a-long-random-secret
